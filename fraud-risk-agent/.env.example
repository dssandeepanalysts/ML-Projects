# Copy to .env and edit. Never commit .env.
# Authentication: set EITHER the OAuth 2.0 block (production) OR FRA_API_TOKEN (local use).
# With neither, the agent refuses to start (docker compose logs fra says why). See DEPLOYMENT.md s4.

# Static bearer token, for local use only; ignored once OAuth is configured. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRA_API_TOKEN=

# OAuth 2.0 (client credentials). Copy the values from your identity provider. The first three are
# required together. The values below in comments are for the local Keycloak (--profile oauth).
FRA_OAUTH_ISSUER=
#   http://localhost:8180/realms/claims
FRA_OAUTH_AUDIENCE=
#   fraud-risk-agent
FRA_OAUTH_JWKS_URL=
#   http://keycloak:8080/realms/claims/protocol/openid-connect/certs
FRA_OAUTH_SCOPE=fraud.assess
# Optional: shown in the Agent Card so callers know where to get tokens.
FRA_OAUTH_TOKEN_URL=
#   http://localhost:8180/realms/claims/protocol/openid-connect/token
# External URL Pega uses; advertised in the Agent Card (use your HTTPS domain in production).
FRA_PUBLIC_URL=http://localhost:8000
FRA_PORT=8000
# Host address the port is published on. Keep 127.0.0.1 when the TLS proxy runs on this host;
# use a private-network IP only if the proxy/load balancer is elsewhere (never a public IP).
FRA_BIND=127.0.0.1
# 1 = reword explanations with Ollama (start with --profile llm); 0 = template only.
FRA_USE_LLM=0
FRA_OLLAMA_MODEL=llama3.2
FRA_LLM_TIMEOUT=8
FRA_LOG_LEVEL=INFO
OLLAMA_VERSION=0.35.1

# Local Keycloak (--profile oauth only; testing, never production).
KC_ADMIN_PASSWORD=
KC_PORT=8180
KEYCLOAK_VERSION=26.8
